#!/bin/sh

set -e

docker-install -r -u build-base wget

rm -rf /build

mkdir -p /build/vlmcsd
cd /build/vlmcsd
wget --no-check-certificate https://github.com/Wind4/vlmcsd/archive/master.tar.gz -q -O - | tar zx
cd vlmcsd-master
make
install -Dm755 bin/vlmcs /usr/local/bin/
install -Dm755 bin/vlmcsd /usr/local/bin/

cd /
rm -rf /build

docker-install -d -c build-base wget

